# -------------------------------------------------------------
# BreachPoint Backend Configuration
# -------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Allowed origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:32081

# Secret used to sign/verify auth JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars

# Postgres connection
DATABASE_URL=postgres://breachpoint:breachpoint@localhost:5432/breachpoint
POSTGRES_USER=breachpoint
POSTGRES_PASSWORD=breachpoint
POSTGRES_DB=breachpoint

# Admin account passwords for seeding (db:seed)
# Accounts: admin@breachpoint.net, ops@breachpoint.net, control@breachpoint.net
ADMIN_1_PASSWORD=AdminPassword2026!
ADMIN_2_PASSWORD=OpsPassword2026!
ADMIN_3_PASSWORD=ControlPassword2026!

# Automatic event publishing on seed (opens window for EVENT_HOURS)
AUTO_PUBLISH=true
EVENT_HOURS=48
