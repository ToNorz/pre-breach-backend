    "public.core_challenge_solve_count": {
      "columns": {
        "challenge_id": {
          "name": "challenge_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "solves": {
          "name": "solves",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n      c.id AS challenge_id,\n      count(s.team_id) AS solves\n  FROM core_challenge c\n  LEFT JOIN core_solve s\n      ON s.challenge_id = c.id\n  GROUP BY c.id\n",
      "name": "core_challenge_solve_count",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
